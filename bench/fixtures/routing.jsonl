# Router eval fixtures — development set.
# One JSON object per line. `gold` is a capability NAME (or "none" to require abstention).
# Names are used instead of ids because the same capability is usually installed under
# several runtime roots, and which copy gets injected does not change whether the task worked.
# Groups: coding, marketing, mcp, agent, trivial, ambiguous, vietnamese.
#
# This set is used for tuning. The holdout set is touched only to confirm a selected
# configuration, never to choose one.

# --- coding (20) ------------------------------------------------------------------
{"id":"coding-auth-refactor","group":"coding","prompt":"refactor the auth middleware to use refresh tokens","gold":["ak-backend-development"],"notes":"the reference case measured during the brainstorm"}
{"id":"coding-rest-api","group":"coding","prompt":"build a REST endpoint for creating invoices with input validation","gold":["ak-backend-development"]}
{"id":"coding-oauth","group":"coding","prompt":"add Google OAuth login with session cookies to the app","gold":["ak-better-auth","ak-backend-development"],"notes":"either is defensible"}
{"id":"coding-sql-index","group":"coding","prompt":"this postgres query does a sequential scan, add the right index","gold":["ak-databases"]}
{"id":"coding-migration","group":"coding","prompt":"write a database migration that backfills the new column safely","gold":["ak-databases","ak-backend-development"]}
{"id":"coding-react-form","group":"coding","prompt":"build a react form component with validation and suspense boundaries","gold":["ak-frontend-development","ak-tanstack"]}
{"id":"coding-render-perf","group":"coding","prompt":"this list re-renders too often, fix the react performance problem","gold":["ak-react-best-practices","ak-frontend-development"]}
{"id":"coding-ssr","group":"coding","prompt":"set up server side rendering and caching for a Next.js app router project","gold":["ak-web-frameworks"]}
{"id":"coding-debug-null","group":"coding","prompt":"I get a cannot read property of undefined error intermittently, help me find the root cause","gold":["ak-debug"]}
{"id":"coding-test-e2e","group":"coding","prompt":"write playwright end to end tests for the checkout flow","gold":["ak-web-testing","ak-test"]}
{"id":"coding-owasp","group":"coding","prompt":"audit this endpoint for SQL injection and secrets in the repo","gold":["ak-security"]}
{"id":"coding-docker","group":"coding","prompt":"dockerize this service and set up a CI pipeline that builds and pushes the image","gold":["ak-devops"]}
{"id":"coding-k8s","group":"coding","prompt":"deploy this container to kubernetes with a helm chart and resource limits","gold":["ak-devops"]}
{"id":"coding-git-branch","group":"coding","prompt":"create a feature branch and open a pull request with a conventional commit message","gold":["ak-git","ak-github"]}
{"id":"coding-issue-triage","group":"coding","prompt":"file a github issue with reproduction steps and label it for triage","gold":["ak-github","source-command-create-github-issue"]}
{"id":"coding-mcp-server","group":"coding","prompt":"build an MCP server that exposes our internal API as tools","gold":["ak-mcp-builder","ak-agentize"]}
{"id":"coding-3d-scene","group":"coding","prompt":"render a 3d scene with a rotating model and lighting using WebGL","gold":["ak-threejs"]}
{"id":"coding-shader","group":"coding","prompt":"write a fragment shader for an animated procedural noise texture","gold":["ak-shader"]}
{"id":"coding-mobile-push","group":"coding","prompt":"add push notifications and offline caching to the mobile app","gold":["ak-mobile-development"]}
{"id":"coding-payments","group":"coding","prompt":"integrate stripe checkout with webhooks for subscription billing","gold":["ak-payment-integration"]}

