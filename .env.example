# Skillful environment
#
# Copy this file to `.env` and fill in your own values. `.env` is gitignored and
# must never be committed.
#
# Skillful has no hosted proxy and runs no server. Your TypeSafe key stays on
# your machine and is used only to call https://api.typesafe.ai directly. Every
# user brings their own key.
#
# Note: Skillful reads TYPESAFE_API_KEY from the process environment only. It
# never reads the key from a config file, and the hook never accepts it as a CLI
# flag, because a flag would expose it in the process list.

# Required: your own TypeSafe API key.
# Create one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Optional: override the TypeSafe API root (default: https://api.typesafe.ai).
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional: model used for routing (default: jev-latest).
# SKILLFUL_MODEL=jev-latest

# Optional: turn routing off without uninstalling the hook. Any non-empty value
# disables injection, which is what the A/B benchmark uses for its control arm.
# SKILLFUL_DISABLE=1

# Optional: disable local telemetry.
# SKILLFUL_TELEMETRY=off

# Optional: override the hard latency budget for the hook, in milliseconds
# (default: 2000).
# SKILLFUL_BUDGET_MS=2000

# ---------------------------------------------------------------------------
# Deploy-only settings (phases 5 and 8). Not needed to run Skillful locally.
# Used to publish the landing page at skillful.agentkit.best.
# ---------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
